generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  firstName              String
  lastName               String?
  phone                  String?           @unique
  role                   UserRole          @default(CUSTOMER)
  termsAcceptedAt        DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  isVerified             Boolean           @default(false)
  otpCode                String?
  otpExpiresAt           DateTime?
  otpAttempts            Int               @default(0)
  passwordResetCode      String?
  passwordResetExpiresAt DateTime?
  passwordResetAttempts  Int               @default(0)
  appointments           Appointment[]
  business               Business?
  businessStaff          BusinessStaff?
  soleProvider           SoleProvider?
  staffInvitationsSent   StaffInvitation[] @relation("StaffInvitedBy")
}

model SoleProvider {
  id            String                 @id @default(uuid())
  userId        String                 @unique
  displayName   String
  serviceName   String?
  category      String?
  experience    String?
  bio           String?
  city          String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  appointments  Appointment[]
  availability  Availability[]
  subscriptions ProviderSubscription[]
  services      Service[]
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id               String                 @id @default(uuid())
  ownerUserId      String                 @unique
  name             String
  category         String?
  staffSize        String?
  email            String?
  phone            String?                @unique
  address          String?
  description      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  appointments     Appointment[]
  owner            User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  staff            BusinessStaff[]
  subscriptions    ProviderSubscription[]
  staffInvitations StaffInvitation[]
  services         Service[]
}

model BusinessStaff {
  id           String         @id @default(uuid())
  businessId   String
  userId       String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  appointments Appointment[]
  availability Availability[]
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     StaffService[]
}

model StaffInvitation {
  id              String    @id @default(uuid())
  businessId      String
  invitedByUserId String
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation("StaffInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId, email, acceptedAt])
  @@index([expiresAt])
}

model Package {
  id                    String                 @id @default(uuid())
  providerType          ProviderType
  tier                  PackageTier
  monthlyPrice          Decimal                @db.Decimal(10, 2)
  dailyAppointmentLimit Int?
  maxStaff              Int?
  featureFlags          Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subscriptions         ProviderSubscription[]

  @@unique([providerType, tier])
}

model ProviderSubscription {
  id                    String                @id @default(uuid())
  soleProviderId        String?
  businessId            String?
  packageId             String
  status                SubscriptionStatus    @default(ACTIVE)
  dailyAppointmentLimit Int?
  maxStaff              Int?
  billingStartDate      DateTime
  nextBillingDate       DateTime
  gracePeriodEndsAt     DateTime?
  paymentStatus         PaymentStatus         @default(PENDING)
  transactionReference  String?
  upgradedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  package               Package               @relation(fields: [packageId], references: [id])
  soleProvider          SoleProvider?         @relation(fields: [soleProviderId], references: [id], onDelete: Cascade)
  payments              SubscriptionPayment[]

  @@index([soleProviderId])
  @@index([businessId])
  @@index([packageId])
  @@index([status])
}

model SubscriptionPayment {
  id                   String               @id @default(uuid())
  subscriptionId       String
  amount               Decimal              @db.Decimal(10, 2)
  status               PaymentStatus        @default(PENDING)
  transactionReference String?
  paidAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  subscription         ProviderSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Service {
  id               String         @id @default(uuid())
  soleProviderId   String?
  businessId       String?
  name             String
  description      String?
  durationMinutes  Int
  expectedPrice    Decimal?       @db.Decimal(10, 2)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  appointments     Appointment[]
  business         Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  soleProvider     SoleProvider?  @relation(fields: [soleProviderId], references: [id], onDelete: Cascade)
  staffAssignments StaffService[]

  @@index([soleProviderId])
  @@index([businessId])
}

model StaffService {
  id        String        @id @default(uuid())
  staffId   String
  serviceId String
  createdAt DateTime      @default(now())
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([serviceId])
}

model Availability {
  id             String         @id @default(uuid())
  soleProviderId String?
  staffId        String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  soleProvider   SoleProvider?  @relation(fields: [soleProviderId], references: [id], onDelete: Cascade)
  staff          BusinessStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([soleProviderId])
  @@index([staffId])
  @@index([dayOfWeek])
}

model Appointment {
  id             String            @id @default(uuid())
  customerId     String
  serviceId      String
  soleProviderId String?
  staffId        String?
  businessId     String?
  scheduledStart DateTime
  status         AppointmentStatus @default(CONFIRMED)
  noShow         Boolean           @default(false)
  lateArrival    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business?         @relation(fields: [businessId], references: [id])
  customer       User              @relation(fields: [customerId], references: [id])
  service        Service           @relation(fields: [serviceId], references: [id])
  soleProvider   SoleProvider?     @relation(fields: [soleProviderId], references: [id])
  staff          BusinessStaff?    @relation(fields: [staffId], references: [id])

  @@index([customerId])
  @@index([serviceId])
  @@index([soleProviderId])
  @@index([staffId])
  @@index([businessId])
  @@index([scheduledStart])
  @@index([status])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum UserRole {
  CUSTOMER
  SOLE_PROVIDER
  BUSINESS_OWNER
  BUSINESS_STAFF
  ADMIN
}

enum ProviderType {
  SOLE_PROVIDER
  BUSINESS
}

enum PackageTier {
  BASIC
  GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}
